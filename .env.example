# ---------- Server ----------
PORT=3000
# Set to 1 behind a reverse proxy (Render, Railway, Fly, Nginx, Cloudflare) so rate limits see real IPs
TRUST_PROXY=0
DB_PATH=./data/site.db

# ---------- Links used by the ads ----------
CALENDLY_URL=https://cal.com/oscar-yasunaga-hf4gs4/coffee-chats
CONTACT_EMAIL=yasunagaoscar@gmail.com

# ---------- Email notifications for the claim form ----------
# Leave SMTP_HOST empty to only store messages in SQLite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
NOTIFY_TO=you@example.com

# ---------- OscarBot (any OpenAI-compatible chat endpoint) ----------
# Local Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=
# Your own LoRA in Ollama (see finetune/README.md):
#   LLM_MODEL=oscarbot
# vLLM with a LoRA adapter (local or on a GPU host):
#   LLM_BASE_URL=http://your-host:8000/v1
#   LLM_MODEL=oscar-voice
#   LLM_API_KEY=the-key-you-passed-to-vllm
# Leave LLM_BASE_URL empty to switch the chat off.

LLM_MAX_TOKENS=400
# Serverless GPUs can take a while to wake up
LLM_TIMEOUT_MS=90000
# Hard cap on chat messages per day across all visitors (protects your bill)
CHAT_DAILY_CAP=500
